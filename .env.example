# FINANCIA+ - variables de entorno
# Copie este archivo como ".env" y ponga sus propios valores.
# El archivo ".env" NO se sube al repositorio (está en .gitignore).
# Todos los valores de aquí son de EJEMPLO: no son credenciales reales.

# Clave con la que Flask firma la cookie de sesión. Genere una propia, larga y aleatoria.
SECRET_KEY=cambie-esta-clave-por-una-aleatoria

# Conexión de la APLICACIÓN: rol sin permiso DELETE (ver docs/DECISIONES_ARQUITECTURA.md, D-15).
DATABASE_URL=postgresql://financia_app:CAMBIAR@localhost:5432/financia

# Conexión para aplicar MIGRACIONES: rol dueño de las tablas.
DATABASE_URL_MIGRACIONES=postgresql://financia_admin:CAMBIAR@localhost:5432/financia

# Base de datos separada para las PRUEBAS automáticas.
DATABASE_URL_PRUEBAS=postgresql://financia_admin:CAMBIAR@localhost:5432/financia_pruebas

# Entorno de Flask: "development" en su computador.
FLASK_ENV=development
